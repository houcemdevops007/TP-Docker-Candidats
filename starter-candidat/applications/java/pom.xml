<?xml version="1.0" encoding="UTF-8"?>
<!--
  TP Docker DevSecOps - Application 1 : API REST Java Spring Boot
  Auteur : Khlifi Houcem - Formateur DevSecOps et Cloud
  Java 21 (LTS) / Spring Boot 4.1 / Maven 3.9
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.formation.devsecops</groupId>
    <artifactId>tp-docker-java</artifactId>
    <version>1.0.0</version>
    <name>tp-docker-java</name>
    <description>API REST Spring Boot du TP Docker DevSecOps</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Serveur web embarque (Tomcat) + Spring MVC + Jackson -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Tests unitaires (JUnit 5, AssertJ, Spring Test) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Nom fixe : le JAR produit sera toujours target/app.jar -->
        <finalName>app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
